# mają trafiać do repozytorium, a globalne "*.png" ucinałoby je po cichu.
/*.jpg
/*.jpeg
/*.png
/*.tif
/*.tiff
/*.dng

# lokalne ustawienia edytorów
.vscode/
.idea/
